# Copy to .env for local runs (never commit the real .env file).
# In GitHub Actions, set these as repo secrets instead: Settings > Secrets and
# variables > Actions > New repository secret.

# Required: Discord webhook to post restock alerts to.
DISCORD_WEBHOOK_URL=

# Optional: free API key from https://developer.bestbuy.com/ (Best Buy checks
# are skipped with a warning if this isn't set).
BESTBUY_API_KEY=

# Optional: override Target's RedSky client key if the built-in default
# starts failing (it's a public client key, not a personal secret).
TARGET_API_KEY=

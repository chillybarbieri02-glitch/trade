# Optional: enables AI-drafted reminder emails via the Anthropic API.
# Without these two set, CollectIQ falls back to deterministic templates
# for the reminder drafts so the app still runs end-to-end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: where the SQLite database file lives. Defaults to ./collectiq.db
COLLECTIQ_DB_PATH=

# Optional: connect a QuickBooks Online company instead of importing CSVs.
# Register an app at https://developer.intuit.com (Development tab gives you
# a sandbox company for testing). Redirect URI must exactly match what you
# register there, e.g. http://localhost:8000/api/integrations/quickbooks/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox

# Optional: connect a Xero organisation instead of importing CSVs.
# Register an app at https://developer.xero.com/app/manage. Redirect URI
# must exactly match what you register there, e.g.
# http://localhost:8000/api/integrations/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
